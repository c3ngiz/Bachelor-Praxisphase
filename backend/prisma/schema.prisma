generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentVisibility {
  private
  shared
  workspace
}

enum WorkspaceRole {
  owner
  editor
  viewer
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  initials     String
  avatarColor  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedDocuments Document[] @relation("DocumentOwner")
  editedDocuments Document[] @relation("DocumentLastEditor")
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  documents Document[]
  members   WorkspaceMember[]

  @@index([ownerId])
  @@index([isDefault])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Document {
  id             String             @id @default(cuid())
  title          String
  content        Json
  revision       Int                @default(1)
  author         String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lastOpenedAt   DateTime?
  visibility     DocumentVisibility @default(private)

  workspaceId    String
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ownerId        String
  ownerName      String
  owner          User               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  collaborators  Json

  lastEditedById   String
  lastEditedByName String
  lastEditedAt     DateTime         @default(now())
  lastEditedBy     User             @relation("DocumentLastEditor", fields: [lastEditedById], references: [id], onDelete: Cascade)
  collaborationState DocumentCollaborationState?

  @@index([ownerId])
  @@index([workspaceId])
  @@index([lastEditedById])
  @@index([revision])
  @@index([updatedAt])
}

model DocumentCollaborationState {
  documentId String   @id
  yjsState   Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
