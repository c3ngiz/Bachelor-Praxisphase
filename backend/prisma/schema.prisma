generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceItemType {
  folder
  document
}

enum PermissionLevel {
  read
  write
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  initials     String
  avatarColor  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaceItems    WorkspaceItem[]             @relation("WorkspaceItemOwner")
  workspaceCollaborators WorkspaceItemCollaborator[]
  editedDocuments        Document[]                  @relation("DocumentLastEditor")
}

model WorkspaceItem {
  id        String            @id @default(cuid())
  name      String
  type      WorkspaceItemType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  ownerId String
  owner   User   @relation("WorkspaceItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  parentId String?
  parent   WorkspaceItem?  @relation("WorkspaceItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children WorkspaceItem[] @relation("WorkspaceItemHierarchy")

  document      Document?
  collaborators WorkspaceItemCollaborator[]

  @@index([ownerId])
  @@index([parentId])
  @@index([type])
  @@index([deletedAt])
  @@index([parentId, name])
}

model Document {
  id               String   @id
  content          Json
  revision         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastOpenedAt     DateTime?
  lastEditedById   String
  lastEditedByName String
  lastEditedAt     DateTime @default(now())

  item               WorkspaceItem               @relation(fields: [id], references: [id], onDelete: Cascade)
  lastEditedBy       User                        @relation("DocumentLastEditor", fields: [lastEditedById], references: [id], onDelete: Cascade)
  collaborationState DocumentCollaborationState?

  @@index([revision])
  @@index([updatedAt])
  @@index([lastEditedById])
}

model WorkspaceItemCollaborator {
  id         String          @id @default(cuid())
  permission PermissionLevel
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  itemId String
  item   WorkspaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId])
  @@index([userId])
}

model DocumentCollaborationState {
  documentId String   @id
  yjsState   Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
