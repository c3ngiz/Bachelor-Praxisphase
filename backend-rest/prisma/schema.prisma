generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceItemType {
  FOLDER
  DOCUMENT
}

enum WorkspacePermission {
  READ
  WRITE
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  name         String
  passwordHash String
  avatarColor  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  ownedItems   WorkspaceItem[]
  shares       WorkspaceShare[]
  collabOps    CollabOperation[]

  @@map("users")
}

model WorkspaceItem {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  type            WorkspaceItemType
  ownerId         String           @db.Uuid
  parentId        String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent          WorkspaceItem?   @relation("WorkspaceItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        WorkspaceItem[]  @relation("WorkspaceItemHierarchy")
  shares          WorkspaceShare[]
  documentContent DocumentContent?
  collabDocument  CollabDocument?

  @@index([deletedAt])
  @@index([ownerId])
  @@index([parentId])
  @@index([type])
  @@map("workspace_items")
}

model WorkspaceShare {
  id         String              @id @default(uuid()) @db.Uuid
  itemId     String              @db.Uuid
  userId     String              @db.Uuid
  permission WorkspacePermission
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  item       WorkspaceItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId])
  @@index([userId])
  @@map("workspace_shares")
}

model DocumentContent {
  id           String        @id @default(uuid()) @db.Uuid
  itemId       String        @unique @db.Uuid
  content      Json
  revision     Int           @default(1)
  lastOpenedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  item         WorkspaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("document_contents")
}

model CollabDocument {
  docId      String             @id @map("doc_id") @db.Uuid
  content    String             @default("")
  version    Int                @default(0)
  updatedAt  DateTime           @default(now()) @map("updated_at")
  item       WorkspaceItem      @relation(fields: [docId], references: [id], onDelete: Cascade)
  operations CollabOperation[]
  snapshots  CollabSnapshot[]
  metrics    CollabMetricEvent[]

  @@map("collab_documents")
}

model CollabOperation {
  opId              String         @id @default(uuid()) @map("op_id") @db.Uuid
  docId             String         @map("doc_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  clientId          String         @map("client_id")
  baseVersion       Int            @map("base_version")
  rawOp             Json           @map("raw_op")
  op                Json
  serverVersion     Int            @map("server_version")
  clientTs          DateTime?      @map("client_ts")
  createdAt         DateTime       @default(now()) @map("created_at")
  transformRequired Boolean        @map("transform_required")
  transformMs       Float          @default(0) @map("transform_ms")
  document          CollabDocument @relation(fields: [docId], references: [docId], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([docId, serverVersion])
  @@index([docId])
  @@index([clientId])
  @@index([createdAt])
  @@map("collab_operations")
}

model CollabSnapshot {
  snapshotId String         @id @default(uuid()) @map("snapshot_id") @db.Uuid
  docId      String         @map("doc_id") @db.Uuid
  version    Int
  content    String
  createdAt  DateTime       @default(now()) @map("created_at")
  document   CollabDocument @relation(fields: [docId], references: [docId], onDelete: Cascade)

  @@index([docId, version])
  @@map("collab_snapshots")
}

model CollabMetricEvent {
  eventId   String         @id @default(uuid()) @map("event_id") @db.Uuid
  docId     String         @map("doc_id") @db.Uuid
  eventType String         @map("event_type")
  payload   Json
  createdAt DateTime       @default(now()) @map("created_at")
  document  CollabDocument @relation(fields: [docId], references: [docId], onDelete: Cascade)

  @@index([docId, eventType])
  @@index([createdAt])
  @@map("collab_metric_events")
}
